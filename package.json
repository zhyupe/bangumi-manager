{
  "name": "bangumi-manager",
  "private": true,
  "description": "A Windows desktop media organizer with reviewed file operations",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhyupe/bangumi-manager.git"
  },
  "packageManager": "pnpm@11.6.0",
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "notices": "node scripts/third-party-notices.mjs",
    "test:core": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e *.json *.ts index.html && cargo fmt --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.0"
  }
}
